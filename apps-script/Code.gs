/** Optional v0.3 additions to the existing bound Apps Script. Merge these handlers into its action router. */
const CAPTURE_HEADERS=['captureId','sessionId','createdAt','sourceUrl','pageTitle','status','screenshotStorageType','screenshotFileId','screenshotUrl','screenshotPartCount','pageWidth','pageHeight','devicePixelRatio','listingCount','warnings','extensionVersion'];
function ensureCapturesSheet_(){const book=SpreadsheetApp.getActive();let sheet=book.getSheetByName('Captures');if(!sheet){sheet=book.insertSheet('Captures');sheet.getRange(1,1,1,CAPTURE_HEADERS.length).setValues([CAPTURE_HEADERS]);}return sheet;}
function saveCapture_(payload){const capture=payload&&payload.capture;if(!capture||!capture.captureId||!capture.sessionId)throw new Error('captureId and sessionId are required');const sheet=ensureCapturesSheet_();const rows=sheet.getDataRange().getValues();const values=CAPTURE_HEADERS.map(key=>capture[key]??'');const index=rows.findIndex((row,i)=>i>0&&row[0]===capture.captureId);if(index>0)sheet.getRange(index+1,1,1,values.length).setValues([values]);else sheet.appendRow(values);return{captureId:capture.captureId};}
function getCapture_(payload){if(!payload||!payload.captureId)throw new Error('captureId is required');const rows=ensureCapturesSheet_().getDataRange().getValues();const row=rows.find((value,i)=>i>0&&value[0]===payload.captureId);if(!row)return null;return Object.fromEntries(CAPTURE_HEADERS.map((header,i)=>[header,row[i]]));}
