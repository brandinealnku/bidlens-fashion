    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.21",
    "prettier": "3.4.2",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
